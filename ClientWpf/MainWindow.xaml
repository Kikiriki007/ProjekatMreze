<Window x:Class="invaders.Client.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Space Invaders - Multiplayer" 
        Width="1050" 
        Height="900"
        MinWidth="800"
        MinHeight="700"
        Background="#0a0e27"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing"
        Focusable="True">

    <Grid>

        <Grid x:Name="ConnectionOverlay" Background="#0a0e27" Panel.ZIndex="10">
            <Border Background="#1a1f3a" 
                    BorderBrush="#00ffff" 
                    BorderThickness="2" 
                    CornerRadius="10"
                    Width="400" 
                    Height="350"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <StackPanel Margin="30">
                    <TextBlock Text="SPACE INVADERS" 
                               FontSize="36" 
                               FontWeight="Bold" 
                               Foreground="#00ffff"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="Server IP:" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="ServerIpTextBox" 
                             Text="127.0.0.1"
                             FontSize="16"
                             Padding="10,5"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Player Name:" Foreground="White" FontSize="14" Margin="0,0,0,5"/>
                    <TextBox x:Name="PlayerNameTextBox" 
                             FontSize="16"
                             Padding="10,5"
                             Margin="0,0,0,20"/>

                    <Button x:Name="ConnectButton"
                            Content="CONNECT" 
                            FontSize="18"
                            FontWeight="Bold"
                            Padding="20,10"
                            Click="ConnectButton_Click"
                            Background="#00ffff"
                            Foreground="Black"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <TextBlock x:Name="ConnectionStatusText" 
                               Text="" 
                               Foreground="#ff00ff" 
                               FontSize="14" 
                               HorizontalAlignment="Center"
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>


        <Grid x:Name="WaitingOverlay" Visibility="Collapsed" Background="#0a0e27" Panel.ZIndex="9">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="WAITING FOR GAME TO START" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#00ffff"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="WaitingInfoText" 
                           Text="" 
                           FontSize="18" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="ControlsText"
                           Text="" 
                           FontSize="14" 
                           Foreground="#888"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Server admin will start the game..." 
                           FontSize="16" 
                           Foreground="#888"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <Border Panel.ZIndex="1" 
                BorderBrush="#00ff00" 
                BorderThickness="3" 
                CornerRadius="10" 
                Margin="10">
            <Border.Effect>
                <DropShadowEffect Color="#00ff00" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PlayerStatsPanel" 
                            Grid.Row="0" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Background="#1a1f3a"
                            Margin="10"/>

                <Canvas x:Name="GameCanvas" 
                        Grid.Row="1" 
                        Background="#0a0e27"
                        SizeChanged="GameCanvas_SizeChanged"
                        ClipToBounds="True"/>

                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           Text="Frame: 0 | Enemies: 0 | Projectiles: 0"
                           Foreground="#00ff00"
                           FontSize="12"
                           Padding="10,5"
                           Background="#1a1f3a"
                           HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00ff00" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <Grid x:Name="GameOverOverlay" Visibility="Collapsed" Panel.ZIndex="11">
            <Border Background="#0a0e27dd" 
                    BorderBrush="#ff00ff" 
                    BorderThickness="3" 
                    CornerRadius="10" 
                    Width="500" 
                    Height="450"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                    <TextBlock Text="GAME OVER" 
                               FontSize="48" 
                               FontWeight="Bold" 
                               Foreground="#ff00ff"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="GameOverReasonText" 
                               Text="" 
                               FontSize="20" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,30"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Border BorderBrush="#00ffff" 
                            BorderThickness="2" 
                            Padding="15" 
                            Margin="0,0,0,20"
                            Background="#1a1f3a">
                        <StackPanel x:Name="RankingsPanel">
                        </StackPanel>
                    </Border>

                    <Button x:Name="PlayAgainButton"
                            Content="PLAY AGAIN (R)" 
                            FontSize="16"
                            FontWeight="Bold"
                            Padding="20,10"
                            Click="PlayAgainButton_Click"
                            Background="#00ff00"
                            Foreground="Black"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="Press ESC to quit" 
                               FontSize="12" 
                               Foreground="#888"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>